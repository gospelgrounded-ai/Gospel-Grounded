# OpenAI API key for Whisper transcription
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API key for Claude (graphics planning + audience analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# YouTube Data API v3 key (optional — enables channel discovery in audience reports)
# Get one at https://console.cloud.google.com → APIs & Services → YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# Path to input video file (can also be passed as CLI arg)
INPUT_VIDEO_PATH=./input/raw_video.mp4

# Output directory for rendered video
OUTPUT_DIR=./out

# Remotion studio port (default 3000)
REMOTION_PORT=3000

# Max word gap in seconds before shortening (matches Descript's 0.2s default)
MAX_WORD_GAP=0.2
