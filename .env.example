# OpenAI API key for Whisper transcription
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API key for Claude (graphics planning)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Path to input video file (can also be passed as CLI arg)
INPUT_VIDEO_PATH=./input/raw_video.mp4

# Output directory for rendered video
OUTPUT_DIR=./out

# Remotion studio port (default 3000)
REMOTION_PORT=3000

# Pauses longer than this (seconds) will be cut from the video
PAUSE_CUT_THRESHOLD=1.0

# How much silence to leave at each trimmed pause (seconds)
PAUSE_KEEP_DURATION=0.3
