{
  "name": "gospel-grounded-video-editor",
  "version": "1.0.0",
  "description": "Automated AI video editing workflow using Remotion, FFmpeg, and OpenAI Whisper",
  "scripts": {
    "edit": "ts-node src/workflow.ts",
    "studio": "npx remotion studio src/Root.tsx",
    "render": "npx remotion render src/Root.tsx VideoComposition out/video.mp4",
    "transcribe": "ts-node src/transcribe.ts",
    "build": "tsc",
    "start": "node dist/workflow.js",
    "lut-server": "ts-node src/lut-server.ts",
    "lut-convert": "ts-node src/lut-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@remotion/bundler": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.1",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "openai": "^4.77.0",
    "remotion": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
